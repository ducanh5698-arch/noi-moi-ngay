{"level":1,"name":"Làm quen","desc":"Chào hỏi, giới thiệu, phép lịch sự cơ bản","topics":[
{"t":"Chào hỏi","s":[
["Hello! How are you?","Xin chào! Bạn khỏe không?"],
["I'm fine, thank you. And you?","Tôi khỏe, cảm ơn. Còn bạn?"],
["Good morning!","Chào buổi sáng!"],
["Good afternoon!","Chào buổi chiều!"],
["Good evening!","Chào buổi tối!"],
["Nice to meet you.","Rất vui được gặp bạn."],
["Nice to meet you too.","Tôi cũng rất vui được gặp bạn."],
["How's it going?","Dạo này thế nào?"],
["Not bad. How about you?","Cũng không tệ. Còn bạn thì sao?"],
["What's up?","Có gì mới không?"],
["Long time no see!","Lâu quá không gặp!"],
["How have you been?","Dạo này bạn thế nào?"],
["I've been busy lately.","Dạo này tôi bận lắm."],
["It's good to see you again.","Thật vui được gặp lại bạn."],
["Goodbye! See you later.","Tạm biệt! Hẹn gặp lại."],
["See you tomorrow.","Hẹn gặp bạn ngày mai."],
["Have a nice day!","Chúc bạn một ngày tốt lành!"],
["Take care!","Bảo trọng nhé!"],
["Good night. Sleep well.","Chúc ngủ ngon."],
["Talk to you soon.","Sớm nói chuyện tiếp nhé."]]},
{"t":"Giới thiệu bản thân","s":[
["What's your name?","Bạn tên là gì?"],
["My name is Duc Anh.","Tên tôi là Đức Anh."],
["You can call me Anh.","Bạn có thể gọi tôi là Anh."],
["Where are you from?","Bạn đến từ đâu?"],
["I'm from Vietnam.","Tôi đến từ Việt Nam."],
["I live in Hanoi.","Tôi sống ở Hà Nội."],
["How old are you?","Bạn bao nhiêu tuổi?"],
["I'm thirty years old.","Tôi ba mươi tuổi."],
["What do you do?","Bạn làm nghề gì?"],
["I'm an engineer.","Tôi là kỹ sư."],
["I work at a small company.","Tôi làm việc ở một công ty nhỏ."],
["I'm a student.","Tôi là sinh viên."],
["Are you married?","Bạn đã lập gia đình chưa?"],
["Yes, I'm married.","Vâng, tôi đã kết hôn."],
["No, I'm single.","Không, tôi còn độc thân."],
["Do you have any children?","Bạn có con chưa?"],
["I have two kids.","Tôi có hai đứa con."],
["What are your hobbies?","Sở thích của bạn là gì?"],
["I like reading and playing football.","Tôi thích đọc sách và đá bóng."],
["I'm learning English.","Tôi đang học tiếng Anh."]]},
{"t":"Lịch sự cơ bản","s":[
["Thank you very much.","Cảm ơn bạn rất nhiều."],
["You're welcome.","Không có gì."],
["Excuse me.","Xin lỗi (cho tôi hỏi / cho tôi qua)."],
["I'm sorry.","Tôi xin lỗi."],
["That's okay.","Không sao đâu."],
["No problem.","Không vấn đề gì."],
["Please.","Làm ơn."],
["Can you help me, please?","Bạn có thể giúp tôi được không?"],
["Sure, I'd be happy to help.","Chắc chắn rồi, tôi rất sẵn lòng."],
["Thanks for your help.","Cảm ơn vì đã giúp tôi."],
["I really appreciate it.","Tôi thực sự trân trọng điều đó."],
["Don't worry about it.","Đừng lo về chuyện đó."],
["After you.","Mời bạn đi trước."],
["Bless you!","Chúc bạn khỏe! (khi ai đó hắt hơi)"],
["Sorry to bother you.","Xin lỗi đã làm phiền bạn."],
["May I come in?","Tôi vào được không?"],
["Yes, please come in.","Vâng, mời vào."],
["Have a seat, please.","Mời bạn ngồi."],
["Congratulations!","Chúc mừng!"],
["Good luck!","Chúc may mắn!"]]},
{"t":"Khi không hiểu","s":[
["Sorry, I don't understand.","Xin lỗi, tôi không hiểu."],
["Could you say that again?","Bạn có thể nói lại được không?"],
["Could you speak more slowly, please?","Bạn có thể nói chậm hơn được không?"],
["What does this word mean?","Từ này nghĩa là gì?"],
["How do you say this in English?","Cái này tiếng Anh nói thế nào?"],
["How do you spell that?","Từ đó đánh vần thế nào?"],
["Can you write it down for me?","Bạn có thể viết ra giúp tôi không?"],
["I didn't catch that.","Tôi nghe không kịp."],
["What did you say?","Bạn vừa nói gì vậy?"],
["Do you speak Vietnamese?","Bạn có nói tiếng Việt không?"],
["I speak a little English.","Tôi nói được một chút tiếng Anh."],
["My English is not very good.","Tiếng Anh của tôi chưa tốt lắm."],
["Is that correct?","Như vậy có đúng không?"],
["Let me think.","Để tôi nghĩ đã."],
["I'm not sure.","Tôi không chắc."],
["I see.","Tôi hiểu rồi."],
["Got it.","Hiểu rồi."],
["What do you mean?","Ý bạn là gì?"],
["Can you give me an example?","Bạn có thể cho tôi một ví dụ không?"],
["I don't know.","Tôi không biết."]]},
{"t":"Trả lời ngắn","s":[
["Yes, of course.","Vâng, tất nhiên rồi."],
["No, thanks.","Không, cảm ơn."],
["Me too.","Tôi cũng vậy."],
["Me neither.","Tôi cũng không."],
["I think so.","Tôi nghĩ vậy."],
["I don't think so.","Tôi không nghĩ vậy."],
["That's right.","Đúng vậy."],
["Really?","Thật à?"],
["That's great!","Tuyệt quá!"],
["Sounds good.","Nghe hay đấy."],
["Okay, let's do it.","Được, làm thôi."],
["Wait a minute.","Đợi một chút."],
["Just a moment, please.","Xin đợi một lát."],
["Here you are.","Của bạn đây."],
["Of course not.","Tất nhiên là không."],
["Maybe.","Có lẽ."],
["It depends.","Còn tùy."],
["Why not?","Sao lại không?"],
["Never mind.","Thôi bỏ đi / Không sao."],
["All right.","Được rồi."]]}
]}
